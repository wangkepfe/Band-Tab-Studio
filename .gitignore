node_modules/
.DS_Store
Thumbs.db
*.log
.claude/
.vscode/
# secrets — NEVER commit. .dev.vars is wrangler's local-dev secret file and holds
# the OAuth client secret + session-signing key. The deployed copies live in
# Cloudflare via `wrangler secret put` and exist nowhere in this repo.
.dev.vars
.dev.vars.*
.env
.env.*
# wrangler local state (local D1 sqlite, build cache) — regenerated
.wrangler/
# python backend
tab-studio/server/.venv/
__pycache__/
# scratch / generated
_work/
# project library — ONE folder of projects. project.json is committed (and shipped
# in the web build); the heavy per-project audio + the runtime marker are not.
projects/.seeded
projects/*/stems/
projects/*/song.*
projects/*/*.wav
projects/*/*.mp3
projects/*/*.m4a
# build output (regenerated): web build + packaged desktop release
dist/
release/
studio-release.zip
studio-web.zip
# research harness — multi-GB datasets + model weights, not for git
research/

# YourMT3+ optional transcriber: isolated install (code+venv+561MB ckpt) and its outputs
tab-studio/server/yourmt3/
tab-studio/server/model_output/
